# ==============================================================================
# FRESH BACKEND — LOCAL DEVELOPMENT & PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `/backend/.env` for local development ONLY.
# NEVER commit `.env` or real production secrets/credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Environment & Debug Mode
# ------------------------------------------------------------------------------
# Production requirement:
#   - `DEBUG` defaults to `False` when omitted.
#   - In production, set `DJANGO_ENV=production` and `DEBUG=False`.
#   - Setting `DEBUG=True` when `DJANGO_ENV=production` fails safely at startup.
DJANGO_ENV=development
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Cryptographic Secret Key & Allowed Hosts
# ------------------------------------------------------------------------------
# Local development value (ONLY permitted when `DEBUG=True`):
SECRET_KEY=local-dev-only-insecure-key-do-not-use-in-production-0123456789abcdef
ALLOWED_HOSTS=127.0.0.1,localhost

# Production requirement (`DEBUG=False`):
#   - `SECRET_KEY` MUST be explicitly provided, >= 50 characters, contain >= 10
#     distinct characters, and MUST NOT contain `django-insecure`, `local-dev-only`,
#     `dummy`, `changeme`, or `placeholder`.
#     Generate with:
#       python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   - `ALLOWED_HOSTS` MUST be explicitly set to comma-separated production domains
#     (e.g., `ALLOWED_HOSTS=api.fresh.sa,internal-api.fresh.sa`). Wildcard `*` is rejected.

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fresh_db
DB_USER=fresh_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 4. Cache & Rate-Limiting Backend (Canonical Variable Names)
# ------------------------------------------------------------------------------
# Always use `CACHE_BACKEND` and `CACHE_LOCATION` (legacy `DJANGO_CACHE_*` names
# are rejected at startup).
#
# Safe single-process local-development option (`DISTRIBUTED_RATE_LIMITING_ENABLED=False`):
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=fresh-auth-security-cache
REQUIRE_SHARED_CACHE=False

# Multi-worker production Redis configuration (`DISTRIBUTED_RATE_LIMITING_ENABLED=True`):
#   Required so authentication rate-limiting counters and JWT allowlist/blocklist
#   state are shared across Gunicorn/uWSGI workers:
#   CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
#   CACHE_LOCATION=redis://127.0.0.1:6379/1
#   # Or with TLS + authentication:
#   # CACHE_LOCATION=rediss://:<redis_password>@<redis_host>:6379/1
#   REQUIRE_SHARED_CACHE=True

# ------------------------------------------------------------------------------
# 5. HTTPS, HSTS & Cookie Security Settings
# ------------------------------------------------------------------------------
# When `DEBUG=False`, `SESSION_COOKIE_SECURE`, `CSRF_COOKIE_SECURE`,
# `SECURE_SSL_REDIRECT`, `SECURE_HSTS_INCLUDE_SUBDOMAINS`, and `SECURE_HSTS_PRELOAD`
# automatically default to `True`, and `SECURE_HSTS_SECONDS` defaults to `31536000`.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------------------------
# 6. Reverse Proxy & Forwarded Headers (Disabled by Default)
# ------------------------------------------------------------------------------
# Arbitrary `X-Forwarded-For`, `X-Forwarded-Proto`, and `X-Forwarded-Host` headers
# are NEVER trusted unless explicitly enabled AND `TRUSTED_PROXY_IPS` lists the
# exact reverse-proxy IPv4/IPv6 addresses or CIDR blocks (wildcards `*` are rejected).
TRUST_X_FORWARDED_FOR=False
TRUST_X_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False
TRUSTED_PROXY_IPS=

# Example behind a trusted load balancer at 10.0.0.0/24:
# TRUST_X_FORWARDED_FOR=True
# TRUST_X_FORWARDED_PROTO=True
# USE_X_FORWARDED_HOST=True
# TRUSTED_PROXY_IPS=10.0.0.0/24

# ------------------------------------------------------------------------------
# 7. Authentication JWT Lifecycle & Rate-Limiting Thresholds
# ------------------------------------------------------------------------------
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=fresh-backend
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_FAILED_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_RATE_LIMIT_REQUESTS=15
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REFRESH_RATE_LIMIT_REQUESTS=10
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
